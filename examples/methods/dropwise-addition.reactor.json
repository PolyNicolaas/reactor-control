{
  "format": "reactor-method/0.2",
  "name": "Dropwise addition at 60 °C",
  "description": "Heat and stir, wait for the probe, add the substrate by hand, dose 10 mL reagent A, let it react, switch off.",
  "author": "Nicolaas",
  "created": "2026-10-27",

  "equipment": {
    "heater": { "kind": "hotplate", "needs": { "setpoints": { "temp": { "max": ">=80" } }, "readings": ["probe"] }, "prefer": ["retControlVisc"] },
    "stirrer": { "kind": "overhead-stirrer", "needs": { "setpoints": { "speed": { "min": "<=200", "max": ">=600" } } }, "prefer": ["eurostar60", "eurostar100"] },
    "reagentA": { "kind": "pump-channel", "needs": { "setpoints": { "flow": { "max": ">=1" } } }, "check": { "tubing": 1.02 }, "label": "Reagent A (1 M NaOH)" }
  },

  "limits": { "heater.temp": { "max": 80 }, "stirrer.speed": { "max": 800 }, "reagentA.flow": { "max": 1 } },

  "steps": [
    { "name": "Heat and stir up", "do": { "heater": { "set": 60 }, "stirrer": { "ramp": 400, "from": 200 } }, "goOnWhen": { "time": "5 min" } },
    { "name": "Reach temperature", "goOnWhen": { "reading": "heater.probe", "atLeast": 58 }, "estimate": "7 min" },
    { "name": "Add the substrate", "goOnWhen": { "person": "Add 5.0 g substrate through the side neck", "record": ["mass added (g)"] }, "estimate": "2 min" },
    { "name": "Dose reagent A", "do": { "reagentA": { "dose": "10 mL", "rate": "0.5 mL/min" } }, "goOnWhen": "dose" },
    { "name": "Let it react", "do": { "reagentA": "off" }, "goOnWhen": { "time": "30 min" } },
    { "name": "Switch off", "do": { "heater": "off", "stirrer": "off" }, "goOnWhen": { "time": "1 min" } }
  ],

  "onAbort": { "reagentA": "off", "heater": "off", "stirrer": "keep" }
}
